    { "id": "awaiting", "type": "waiting", "label": "awaiting_confirm", "sublabel": "Approve / Deny dialog", "lane": "waiting", "col": 0, "tag": "StepStatus" },
    { "id": "repair", "type": "neutral", "label": "llm.repair()", "sublabel": "still running, attempt 2", "lane": "recovery", "col": 1, "tag": "not a status" },
