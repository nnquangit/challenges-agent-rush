# ProofBox environment — copy to .env.local ONLY when real Vultr accounts exist.
# Mock-first phase: MOCK=1 means no network calls to Vultr at all.
MOCK=1

# --- Vultr Serverless Inference (OpenAI-compatible). Used only when MOCK=0. ---
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=
VULTR_INFERENCE_API_KEY=

# --- Vultr sandbox host (Docker/gVisor on a Vultr VM). Used only when MOCK=0. ---
VULTR_SANDBOX_HOST=
VULTR_SANDBOX_TOKEN=
VULTR_API_KEY=

# --- Sandbox limits (apply to mock and real providers) ---
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=256

# --- Control-plane policy (apply to mock and real providers) ---
# Hosts the sandboxed browser may reach. Neither the planner nor API clients can add hosts.
SANDBOX_EGRESS_ALLOWLIST=shop.example.com,example.com,docs.example.com
# Sandboxes alive at once (runs queue; ad-hoc /api/sandbox/exec gets 429).
SANDBOX_MAX_CONCURRENT=3
# Ad-hoc /api/sandbox/exec calls per session principal (and per client IP behind a trusted proxy) per minute.
SANDBOX_EXEC_PER_MINUTE=20
# More limits (all optional, defaults in src/lib/config.ts): SANDBOX_SLOTS_PER_PRINCIPAL=2, SANDBOX_MAX_QUEUED=12,
# SANDBOX_QUEUE_PER_PRINCIPAL=4, SANDBOX_EXEC_WAIT_MS=5000, SANDBOX_RUN_WAIT_MS=120000, CHAT_PER_MINUTE=20,
# RUNS_PER_MINUTE=10, RUNS_ACTIVE_PER_PRINCIPAL=2, RUNS_ACTIVE_MAX=8, CONFIRM_TTL_MS=600000,
# SESSIONS_PER_MINUTE=60, SESSIONS_PER_IP_PER_MINUTE=10, SESSION_TTL_MS=43200000

# --- Exposure and access ---
# 1 = public: any Host, Secure cookies, and the server REFUSES TO START without PROOFBOX_DEMO_TOKEN and
# RECEIPT_SIGNING_KEY. Unset/0 = local: the API answers only loopback Host headers (localhost, 127.0.0.1, [::1]).
PROOFBOX_PUBLIC=
# Access token (>= 16 characters). When set, POST /api/session needs header x-proofbox-token; every other
# API call needs the session cookie it sets. Not an identity: each session is its own principal. Required when public.
PROOFBOX_DEMO_TOKEN=
# Optional: HMAC key for session cookies (>= 32 characters). Unset = random per process (sessions end on restart).
PROOFBOX_SESSION_SECRET=
# Number of reverse proxies that append X-Forwarded-For (e.g. 1 behind Caddy). 0/unset = never read proxy headers.
PROOFBOX_TRUST_PROXY=

# Base64 PKCS#8 DER Ed25519 key for signing receipts, validated at start (a bad key stops the server).
# Unset = ephemeral key per process (old receipts stop verifying after a restart). Required when public.
# Generate ONCE per deployment and keep it outside the repo:
# node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
RECEIPT_SIGNING_KEY=
