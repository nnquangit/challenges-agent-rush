  "cards": [
    {
      "dot": "cyan",
      "title": "Plan before anything runs",
      "items": [
        "POST /api/chat only plans: getLlm().plan(), then enforcePolicy() and savePlan() (src/app/api/chat/route.ts)",
        "POST /api/runs takes a stored planId, never client steps (src/app/api/runs/route.ts)"
      ]
    },
    {
      "dot": "emerald",
      "title": "One sandbox per step",
      "items": [
        "advance() walks the steps; executeStep() retries a failed code step once via llm.repair() (MAX_ATTEMPTS = 2)",
        "runInSandbox: redact env → create → exec → artifacts → destroy() in finally → sealReceipt()"
      ]
    },
    {
      "dot": "amber",
      "title": "Simulated in this build",
      "items": [
        "MockLlm and MockSandbox are used while MOCK=1 (default, src/lib/config.ts)",
        "No container or VM runs; the UI polls the in-memory run every 450 ms"
      ]
    }
