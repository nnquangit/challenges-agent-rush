  "cards": [
    {
      "dot": "rose",
      "title": "Gate owned by the server",
      "items": [
        "enforcePolicy() forces requiresConfirm on every browser submit (src/lib/policy.ts)",
        "advance() re-checks it and stops at awaiting_confirm even if the planner forgot the flag (src/lib/orchestrator.ts)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Approve",
      "items": [
        "confirmStep() sets the step back to pending and calls advance(); the submit step then runs in a fresh sandbox"
      ]
    },
    {
      "dot": "amber",
      "title": "Deny",
      "items": [
        "The step is marked skipped with the note \"Nothing was submitted\"; no sandbox is created for it",
        "Probes are placed before the gate, so containment is shown even when the human denies"
      ]
    }
