  "cards": [
    {
      "dot": "emerald",
      "title": "What is covered",
      "items": [
        "sha256 and Ed25519 cover the canonical JSON of the whole receipt minus sha256/signature: input, output, artifacts, limits, env, isolation, clock, sealedAt",
        "runInSandbox() seals only after destroy(), so isolation.destroyed is inside the signed payload"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two verifiers, same bytes",
      "items": [
        "ReceiptViewer and scripts/verify-receipt.mjs both call receiptPayload() and fetch GET /api/receipts/public-key",
        "verify-receipt defaults to --base http://localhost:3000; pass --key or --base for another server"
      ]
    },
    {
      "dot": "amber",
      "title": "Limits of the proof",
      "items": [
        "A signature proves the receipt was not edited after sealing, not that isolation happened",
        "In mock mode isolation is simulated: true and written by MockSandbox itself",
        "Without RECEIPT_SIGNING_KEY the key is ephemeral; old receipts fail after a restart"
      ]
    }
  ]
}