  "cards": [
    {
      "dot": "emerald",
      "title": "Main journey",
      "items": [
        "POST /api/chat: LLM plans, enforcePolicy validates and adds probes; nothing runs",
        "POST /api/runs starts the orchestrator on a stored planId",
        "The UI polls GET /api/runs/:id for receipts"
      ]
    },
    {
      "dot": "rose",
      "title": "Controls in server code",
      "items": [
        "Server-inserted probes, forced confirm on submit, egress = user hosts ∩ server allowlist",
        "One sandbox session per attempt, destroy() in finally, max SANDBOX_MAX_CONCURRENT slots",
        "Whole receipt hashed (sha256) and signed (Ed25519) after destroy"
      ]
    },
    {
      "dot": "amber",
      "title": "Not protected yet",
      "items": [
        "Token and rate limit cover only /api/sandbox/exec; chat and runs are open",
        "Rate-limit key trusts client x-forwarded-for; runs readable without auth",
        "MockSandbox runs no code: isolation is simulated, not proven"
      ]
    },
    {
      "dot": "slate",
      "title": "Mode switch",
      "items": [
        "MOCK defaults to on; only MOCK=0 selects the Vultr stubs",
        "VultrInferenceLlm (Vultr Serverless Inference) and VultrSandbox (Docker + gVisor VM) are planned stubs that throw; nothing calls Vultr"
      ]
    }
  ]
